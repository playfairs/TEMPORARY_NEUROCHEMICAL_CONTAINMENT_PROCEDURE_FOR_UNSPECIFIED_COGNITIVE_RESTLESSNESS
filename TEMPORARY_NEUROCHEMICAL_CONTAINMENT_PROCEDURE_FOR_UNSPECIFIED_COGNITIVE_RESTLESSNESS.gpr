project TEMPORARY_NEUROCHEMICAL_CONTAINMENT_PROCEDURE_FOR_UNSPECIFIED_COGNITIVE_RESTLESSNESS is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("boredom.adb");
   for Languages use ("Ada");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-O2", "-gnatwU");
   end Compiler;

   package Linker is
      for Switches ("Ada") use ("-L/Library/Developer/CommandLineTools/SDKs/MacOSX26.4.sdk/usr/lib", "-lSystem");
   end Linker;
end TEMPORARY_NEUROCHEMICAL_CONTAINMENT_PROCEDURE_FOR_UNSPECIFIED_COGNITIVE_RESTLESSNESS;
